# ==========================================
# Image-to-3D Mesh Agent Environment Config
# ==========================================

# Optional: Google Gemini API Key for Tier 2 Watchdog Fallback
# Get your API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Hugging Face Cache Directory (defaults to ./cache/hf or /kaggle/working/cache/hf)
HF_HOME=./cache/hf

# Watchdog timeout cap in seconds (default: 80)
WATCHDOG_TIMEOUT_SECONDS=80

# CUDA Allocation Configuration to avoid VRAM fragmentation
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
